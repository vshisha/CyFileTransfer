package com.cyfiletransfer.app

import android.content.Context
import fi.iki.elonen.NanoHTTPD
import org.json.JSONArray
import org.json.JSONObject
import java.io.File
import java.io.FileInputStream
import java.io.FileOutputStream
import java.net.NetworkInterface
import java.net.URLConnection
import java.net.URLEncoder

object LocalHttpServer {

    private const val PORT = 1111
    private const val UPLOAD_FIELD = "file"

    private var server: NanoHTTPD? = null
    private var appContext: Context? = null

    @Synchronized
    fun start(context: Context): Boolean {
        if (server?.isAlive == true) return true

        appContext = context.applicationContext

        return try {
            val newServer = object : NanoHTTPD(PORT) {

                override fun serve(session: IHTTPSession): Response {
                    return try {
                        when {
                            session.method == Method.OPTIONS -> {
                                jsonResponse(JSONObject().put("ok", true))
                            }

                            session.method == Method.GET && session.uri == "/" -> {
                                newFixedLengthResponse(
                                    Response.Status.OK,
                                    "text/html; charset=UTF-8",
                                    """
                                    <!DOCTYPE html>
                                    <html lang="ru">
                                    <head><meta charset="UTF-8"><title>CyFileTransfer</title></head>
                                    <body>
                                      <h1>CyFileTransfer</h1>
                                      <p>HTTP-сервер работает. Веб-интерфейс будет добавлен следующим этапом.</p>
                                    </body>
                                    </html>
                                    """.trimIndent()
                                )
                            }

                            session.method == Method.GET && session.uri == "/api/files" -> {
                                listFiles()
                            }

                            session.method == Method.POST && session.uri == "/api/upload" -> {
                                uploadFile(session)
                            }

                            session.method == Method.GET && session.uri == "/api/download" -> {
                                downloadFile(session)
                            }

                            session.method == Method.DELETE && session.uri == "/api/delete" -> {
                                deleteFile(session)
                            }

                            else -> jsonResponse(
                                JSONObject().put("error", "Маршрут не найден"),
                                Response.Status.NOT_FOUND
                            )
                        }
                    } catch (e: Exception) {
                        jsonResponse(
                            JSONObject().put("error", e.message ?: "Внутренняя ошибка сервера"),
                            Response.Status.INTERNAL_ERROR
                        )
                    }
                }
            }

            newServer.start(NanoHTTPD.SOCKET_READ_TIMEOUT, false)
            server = newServer
            true
        } catch (_: Exception) {
            server = null
            false
        }
    }

    private fun getFolder(): File? {
        val context = appContext ?: return null
        return FileStorage.getFolder(context)
    }

    private fun safeFile(name: String): File? {
        val folder = getFolder() ?: return null

        if (name.isBlank() || name == "." || name == ".." ||
            name.contains("/") || name.contains("\\")
        ) return null

        return try {
            val file = File(folder, name)
            if (file.canonicalFile.parentFile == folder.canonicalFile) file else null
        } catch (_: Exception) {
            null
        }
    }

    private fun listFiles(): Response {
        val folder = getFolder()
            ?: return jsonResponse(
                JSONObject().put("error", "Папка хранения недоступна"),
                Response.Status.INTERNAL_ERROR
            )

        val array = JSONArray()

        folder.listFiles()
            ?.filter { it.isFile }
            ?.sortedByDescending { it.lastModified() }
            ?.forEach { file ->
                val item = JSONObject()
                    .put("name", file.name)
                    .put("size", file.length())
                    .put("lastModified", file.lastModified())
                    .put(
                        "mimeType",
                        URLConnection.guessContentTypeFromName(file.name) ?: "application/octet-stream"
                    )

                array.put(item)
            }

        return jsonResponse(
            JSONObject()
                .put("ok", true)
                .put("files", array)
        )
    }

    private fun uploadFile(session: IHTTPSession): Response {
        val folder = getFolder()
            ?: return jsonResponse(
                JSONObject().put("error", "Папка хранения недоступна"),
                Response.Status.INTERNAL_ERROR
            )

        val tempFiles = HashMap<String, String>()
        session.parseBody(tempFiles)

        val tempPath = tempFiles[UPLOAD_FIELD]
            ?: return jsonResponse(
                JSONObject().put("error", "Файл не передан. Используйте поле file."),
                Response.Status.BAD_REQUEST
            )

        val originalName = session.parms[UPLOAD_FIELD]
            ?: "upload_${System.currentTimeMillis()}.bin"

        val cleanName = originalName
            .substringAfterLast('/')
            .substringAfterLast('\\')
            .replace(Regex("[\\r\\n]"), "_")
            .ifBlank { "upload_${System.currentTimeMillis()}.bin" }

        var destination = File(folder, cleanName)
        var counter = 1

        while (destination.exists()) {
            val dot = cleanName.lastIndexOf('.')
            val base = if (dot > 0) cleanName.substring(0, dot) else cleanName
            val extension = if (dot > 0) cleanName.substring(dot) else ""
            destination = File(folder, "$base ($counter)$extension")
            counter++
        }

        FileInputStream(tempPath).use { input ->
            FileOutputStream(destination).use { output ->
                input.copyTo(output, 64 * 1024)
            }
        }

        return jsonResponse(
            JSONObject()
                .put("ok", true)
                .put("name", destination.name)
                .put("size", destination.length())
        )
    }

    private fun downloadFile(session: IHTTPSession): Response {
        val name = session.parms["name"]
            ?: return jsonResponse(
                JSONObject().put("error", "Не указано имя файла"),
                Response.Status.BAD_REQUEST
            )

        val file = safeFile(name)
            ?: return jsonResponse(
                JSONObject().put("error", "Некорректное имя файла"),
                Response.Status.BAD_REQUEST
            )

        if (!file.isFile) {
            return jsonResponse(
                JSONObject().put("error", "Файл не найден"),
                Response.Status.NOT_FOUND
            )
        }

        val mime = URLConnection.guessContentTypeFromName(file.name)
            ?: "application/octet-stream"

        val encodedName = URLEncoder.encode(file.name, "UTF-8").replace("+", "%20")

        return newFixedLengthResponse(
            Response.Status.OK,
            mime,
            FileInputStream(file),
            file.length()
        ).apply {
            addHeader("Content-Disposition", "attachment; filename*=UTF-8''$encodedName")
        }
    }

    private fun deleteFile(session: IHTTPSession): Response {
        val name = session.parms["name"]
            ?: return jsonResponse(
                JSONObject().put("error", "Не указано имя файла"),
                Response.Status.BAD_REQUEST
            )

        val file = safeFile(name)
            ?: return jsonResponse(
                JSONObject().put("error", "Некорректное имя файла"),
                Response.Status.BAD_REQUEST
            )

        if (!file.isFile) {
            return jsonResponse(
                JSONObject().put("error", "Файл не найден"),
                Response.Status.NOT_FOUND
            )
        }

        val deleted = file.delete()

        return jsonResponse(
            JSONObject()
                .put("ok", deleted)
                .put("name", name),
            if (deleted) Response.Status.OK else Response.Status.INTERNAL_ERROR
        )
    }

    private fun jsonResponse(
        json: JSONObject,
        status: Response.IStatus = Response.Status.OK
    ): Response {
        return newFixedLengthResponse(
            status,
            "application/json; charset=UTF-8",
            json.toString()
        ).apply {
            addHeader("Access-Control-Allow-Origin", "*")
            addHeader("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
            addHeader("Access-Control-Allow-Headers", "Content-Type")
        }
    }

    @Synchronized
    fun stop() {
        server?.stop()
        server = null
    }

    fun isRunning(): Boolean = server?.isAlive == true

    fun getLocalIpAddress(): String? {
        return try {
            val interfaces = NetworkInterface.getNetworkInterfaces()

            while (interfaces.hasMoreElements()) {
                val networkInterface = interfaces.nextElement()

                if (!networkInterface.isUp || networkInterface.isLoopback) continue

                val addresses = networkInterface.inetAddresses

                while (addresses.hasMoreElements()) {
                    val address = addresses.nextElement()

                    if (!address.isLoopbackAddress &&
                        address.hostAddress?.contains(':') == false
                    ) {
                        return address.hostAddress
                    }
                }
            }

            null
        } catch (_: Exception) {
            null
        }
    }

    fun getPort(): Int = PORT
}
