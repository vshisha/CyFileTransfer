@OptIn(ExperimentalFoundationApi::class)
@Composable
fun FilesScreen(onBack: () -> Unit) {
    val colors = MaterialTheme.colorScheme
    val context = androidx.compose.ui.platform.LocalContext.current
    val scope = rememberCoroutineScope()

    var files by remember { mutableStateOf<List<StoredFile>>(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }
    var refreshKey by remember { mutableStateOf(0) }
    var selectedFile by remember { mutableStateOf<StoredFile?>(null) }
    var fileToDelete by remember { mutableStateOf<StoredFile?>(null) }

    LaunchedEffect(refreshKey) {
        isLoading = true
        files = withContext(Dispatchers.IO) {
            FileStorage.getFiles(context)
        }
        isLoading = false
    }

    fun openFile(file: StoredFile) {
        try {
            val uri = FileProvider.getUriForFile(
                context,
                "${context.packageName}.fileprovider",
                java.io.File(
                    FileStorage.getFolder(context),
                    file.name
                )
            )

            val extension = file.name.substringAfterLast(
                ".",
                ""
            ).lowercase()

            val mimeType = MimeTypeMap.getSingleton()
                .getMimeTypeFromExtension(extension)
                ?: "*/*"

            val intent = Intent(Intent.ACTION_VIEW).apply {
                setDataAndType(uri, mimeType)
                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            }

            context.startActivity(intent)
        } catch (_: android.content.ActivityNotFoundException) {
            Toast.makeText(
                context,
                "Нет приложения для открытия этого файла",
                Toast.LENGTH_LONG
            ).show()
        } catch (_: Exception) {
            Toast.makeText(
                context,
                "Не удалось открыть файл",
                Toast.LENGTH_LONG
            ).show()
        }
    }

    BoxWithConstraints(
        modifier = Modifier
            .fillMaxSize()
            .background(colors.background)
    ) {
        val isTV = maxWidth >= 700.dp

        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(
                    horizontal = if (isTV) 48.dp else 20.dp,
                    vertical = if (isTV) 32.dp else 24.dp
                )
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Button(
                    onClick = onBack,
                    shape = RoundedCornerShape(12.dp)
                ) {
                    Text("←  Назад")
                }

                Spacer(Modifier.width(20.dp))

                Text(
                    "Мои файлы",
                    modifier = Modifier.weight(1f),
                    fontSize = if (isTV) 29.sp else 22.sp,
                    fontWeight = FontWeight.Bold,
                    color = colors.onBackground
                )

                TextButton(onClick = { refreshKey++ }) {
                    Text("Обновить")
                }
            }

            Spacer(Modifier.height(20.dp))

            Text(
                "Хранилище приложения / PhoneTransfer",
                fontSize = if (isTV) 16.sp else 13.sp,
                color = colors.onSurfaceVariant
            )

            Spacer(Modifier.height(12.dp))

            Text(
                "Файлов: ${files.size}",
                fontSize = 13.sp,
                color = colors.onSurfaceVariant
            )

            Spacer(Modifier.height(16.dp))

            if (isLoading) {
                Box(
                    modifier = Modifier
                        .fillMaxWidth()
                        .weight(1f),
                    contentAlignment = Alignment.Center
                ) {
                    CircularProgressIndicator()
                }
            } else if (files.isEmpty()) {
                Card(
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(22.dp),
                    colors = CardDefaults.cardColors(
                        containerColor = colors.surface
                    )
                ) {
                    Column(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(32.dp),
                        horizontalAlignment = Alignment.CenterHorizontally,
                        verticalArrangement = Arrangement.spacedBy(12.dp)
                    ) {
                        Text(
                            "Пока нет файлов",
                            fontSize = if (isTV) 22.sp else 18.sp,
                            fontWeight = FontWeight.SemiBold,
                            color = colors.onSurface
                        )

                        Text(
                            "Переданные файлы будут отображаться здесь.\n" +
                                "Сервер запускать для просмотра не требуется.",
                            fontSize = if (isTV) 15.sp else 13.sp,
                            color = colors.onSurfaceVariant,
                            textAlign = TextAlign.Center,
                            lineHeight = 22.sp
                        )
                    }
                }
            } else {
                Column(
                    modifier = Modifier
                        .weight(1f)
                        .fillMaxWidth()
                        .verticalScroll(rememberScrollState()),
                    verticalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    files.forEach { file ->
                        var focused by remember(file.name) {
                            mutableStateOf(false)
                        }

                        Box {
                            Card(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .onFocusChanged {
                                        focused = it.isFocused
                                    }
                                    .focusable()
                                    .combinedClickable(
                                        onClick = {
                                            openFile(file)
                                        },
                                        onLongClick = {
                                            selectedFile = file
                                        }
                                    )
                                    .then(
                                        if (focused) {
                                            Modifier.border(
                                                3.dp,
                                                colors.primary,
                                                RoundedCornerShape(16.dp)
                                            )
                                        } else {
                                            Modifier
                                        }
                                    ),
                                shape = RoundedCornerShape(16.dp),
                                colors = CardDefaults.cardColors(
                                    containerColor = if (focused) {
                                        colors.surfaceVariant
                                    } else {
                                        colors.surface
                                    }
                                )
                            ) {
                                Row(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .padding(
                                            horizontal = 22.dp,
                                            vertical = if (isTV) 22.dp else 16.dp
                                        ),
                                    verticalAlignment = Alignment.CenterVertically
                                ) {
                                    Column(
                                        modifier = Modifier.weight(1f),
                                        verticalArrangement = Arrangement.spacedBy(7.dp)
                                    ) {
                                        Text(
                                            file.name,
                                            fontSize = if (isTV) 19.sp else 15.sp,
                                            fontWeight = FontWeight.SemiBold,
                                            color = colors.onSurface
                                        )

                                        Text(
                                            "Размер: ${formatFileSize(file.size)}",
                                            fontSize = 13.sp,
                                            color = colors.onSurfaceVariant
                                        )

                                        Text(
                                            "Изменён: ${formatFileDate(file.lastModified)}",
                                            fontSize = 12.sp,
                                            color = colors.onSurfaceVariant
                                        )
                                    }

                                    Text(
                                        "›",
                                        fontSize = 30.sp,
                                        color = colors.primary
                                    )
                                }
                            }

                            DropdownMenu(
                                expanded = selectedFile?.name == file.name,
                                onDismissRequest = {
                                    selectedFile = null
                                }
                            ) {
                                DropdownMenuItem(
                                    text = { Text("Открыть") },
                                    onClick = {
                                        selectedFile = null
                                        openFile(file)
                                    }
                                )

                                DropdownMenuItem(
                                    text = {
                                        Text(
                                            "Удалить",
                                            color = colors.error
                                        )
                                    },
                                    onClick = {
                                        selectedFile = null
                                        fileToDelete = file
                                    }
                                )
                            }
                        }
                    }
                }
            }
        }
    }

    fileToDelete?.let { file ->
        AlertDialog(
            onDismissRequest = {
                fileToDelete = null
            },
            title = {
                Text("Удалить файл?")
            },
            text = {
                Text(
                    "Файл «${file.name}» будет удалён без возможности восстановления."
                )
            },
            confirmButton = {
                Button(
                    onClick = {
                        fileToDelete = null

                        scope.launch {
                            val deleted = withContext(Dispatchers.IO) {
                                FileStorage.deleteFile(context, file.name)
                            }

                            if (deleted) {
                                Toast.makeText(
                                    context,
                                    "Файл удалён",
                                    Toast.LENGTH_SHORT
                                ).show()
                                refreshKey++
                            } else {
                                Toast.makeText(
                                    context,
                                    "Не удалось удалить файл",
                                    Toast.LENGTH_LONG
                                ).show()
                            }
                        }
                    },
                    colors = ButtonDefaults.buttonColors(
                        containerColor = colors.error
                    )
                ) {
                    Text("Удалить")
                }
            },
            dismissButton = {
                TextButton(
                    onClick = { fileToDelete = null }
                ) {
                    Text("Отмена")
                }
            }
        )
    }
}

private fun formatFileSize(size: Long): String {
    return when {
        size < 1024 -> "$size Б"
        size < 1024 * 1024 ->
            String.format("%.1f КБ", size / 1024.0)
        size < 1024L * 1024 * 1024 ->
            String.format("%.1f МБ", size / (1024.0 * 1024))
        else ->
            String.format("%.2f ГБ", size / (1024.0 * 1024 * 1024))
    }
}

private fun formatFileDate(timestamp: Long): String {
    if (timestamp <= 0L) return "неизвестно"

    return java.text.SimpleDateFormat(
        "dd.MM.yyyy HH:mm",
        java.util.Locale.getDefault()
    ).format(java.util.Date(timestamp))
}

