function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' Б';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' КБ';
    if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + ' МБ';
    return (bytes / 1073741824).toFixed(2) + ' ГБ';
}

function formatDate(value) {
    return new Date(value).toLocaleString('ru-RU');
}

async function loadFiles() {
    try {
        const response = await fetch('/api/files');
        const data = await response.json();
        if (!data.ok) throw new Error(data.error || 'Ошибка получения списка');

        filesBox.replaceChildren();

        if (!data.files.length) {
            const empty = document.createElement('div');
            empty.className = 'empty';
            empty.textContent = 'Пока нет загруженных файлов';
            filesBox.appendChild(empty);
            return;
        }

        data.files.forEach(file => {
            const row = document.createElement('div');
            row.className = 'file';

            const info = document.createElement('div');
            info.className = 'file-info';

            const name = document.createElement('div');
            name.className = 'file-name';
            name.textContent = file.name;

            const meta = document.createElement('div');
            meta.className = 'file-meta';
            meta.textContent = formatSize(file.size) + ' · ' + formatDate(file.lastModified);

            info.append(name, meta);

            const actions = document.createElement('div');
            actions.className = 'file-actions';

            const download = document.createElement('button');
            download.textContent = 'Скачать';
            download.addEventListener('click', () => {
                window.location.href = '/api/download?name=' + encodeURIComponent(file.name);
            });

            const remove = document.createElement('button');
            remove.textContent = 'Удалить';
            remove.className = 'delete';
            remove.addEventListener('click', () => deleteFile(file.name));

            actions.append(download, remove);
            row.append(info, actions);
            filesBox.appendChild(row);
        });
    } catch (error) {
        filesBox.textContent = 'Не удалось загрузить список: ' + error.message;
    }
}

async function deleteFile(name) {
    if (!confirm('Удалить файл "' + name + '"?')) return;

    try {
        const response = await fetch('/api/delete?name=' + encodeURIComponent(name), {
            method: 'DELETE'
        });
        const data = await response.json();
        if (!data.ok) throw new Error(data.error || 'Не удалось удалить файл');
        message.textContent = 'Файл удалён: ' + name;
        loadFiles();
    } catch (error) {
        message.textContent = 'Ошибка удаления: ' + error.message;
    }
}

function uploadFile(file) {
    return new Promise(resolve => {
        const item = document.createElement('div');
        item.className = 'progress-item';

        const title = document.createElement('div');
        title.className = 'progress-title';

        const fileName = document.createElement('span');
        fileName.textContent = file.name;

        const details = document.createElement('span');
        details.textContent = '0%';

        const bar = document.createElement('progress');
        bar.max = 100;
        bar.value = 0;

        title.append(fileName, details);
        item.append(title, bar);
        progressBox.appendChild(item);

        const xhr = new XMLHttpRequest();
        const started = Date.now();
        let previousLoaded = 0;
        let previousTime = started;
        let speed = 0;

        xhr.open('POST', '/api/upload');

        xhr.upload.addEventListener('progress', event => {
            if (!event.lengthComputable) return;

            const now = Date.now();
            const percent = Math.round(event.loaded / event.total * 100);
            const elapsed = (now - previousTime) / 1000;

            if (elapsed >= 0.5) {
                speed = (event.loaded - previousLoaded) / elapsed;
                previousLoaded = event.loaded;
                previousTime = now;
            }

            const remaining = speed > 0 ? (event.total - event.loaded) / speed : 0;
            details.textContent = percent + '% · ' + formatSize(speed) + '/с · осталось ' + Math.ceil(remaining) + ' с';
            bar.value = percent;
        });

        xhr.onload = () => {
            try {
                const data = JSON.parse(xhr.responseText);
                if (xhr.status >= 200 && xhr.status < 300 && data.ok) {
                    details.textContent = 'Готово · ' + formatSize(file.size);
                    bar.value = 100;
                } else {
                    details.textContent = 'Ошибка: ' + (data.error || xhr.status);
                }
            } catch (_) {
                details.textContent = 'Ошибка ответа сервера';
            }
            resolve();
        };

        xhr.onerror = () => {
            details.textContent = 'Ошибка соединения';
            resolve();
        };

        const form = new FormData();
        form.append('file', file, file.name);
        xhr.send(form);
    });
}

