@Composable
fun ServerCard(
    modifier: Modifier = Modifier,
    isTV: Boolean,
    rightFocusRequester: FocusRequester? = null
) {
    val colors = MaterialTheme.colorScheme
    val context = LocalContext.current
    val scope = rememberCoroutineScope()
    val focusRequester = remember { FocusRequester() }

    var isRunning by remember { mutableStateOf(LocalHttpServer.isRunning()) }
    var isStarting by remember { mutableStateOf(false) }
    var ipAddress by remember {
        mutableStateOf(if (isRunning) LocalHttpServer.getLocalIpAddress() else null)
    }
    var errorMessage by remember { mutableStateOf<String?>(null) }
    var focused by remember { mutableStateOf(false) }

    LaunchedEffect(Unit) {
        delay(350)
        try {
            focusRequester.requestFocus()
        } catch (_: Exception) {
        }
    }

    LaunchedEffect(Unit) {
        while (true) {
            val running = withContext(Dispatchers.IO) {
                LocalHttpServer.isRunning()
            }
            isRunning = running
            ipAddress = if (running) LocalHttpServer.getLocalIpAddress() else null
            delay(1000)
        }
    }

    val url = ipAddress?.let { "http://$it:${LocalHttpServer.getPort()}" }

    val toggleServer: () -> Unit = {
        if (!isStarting) {
            isStarting = true
            errorMessage = null

            scope.launch {
                try {
                    if (isRunning) {
                        val stopIntent = Intent(context, FileServerService::class.java).apply {
                            action = FileServerService.ACTION_STOP
                        }
                        context.startService(stopIntent)
                        isRunning = false
                        ipAddress = null
                    } else {
                        val serviceIntent = Intent(context, FileServerService::class.java)
                        ContextCompat.startForegroundService(context, serviceIntent)
                        delay(900)

                        isRunning = LocalHttpServer.isRunning()
                        ipAddress = if (isRunning) {
                            LocalHttpServer.getLocalIpAddress()
                        } else {
                            null
                        }

                        if (!isRunning) {
                            errorMessage = "Не удалось запустить сервер. Проверьте порт 1111."
                        } else if (ipAddress == null) {
                            errorMessage = "Сервер запущен, но IP-адрес не найден."
                        }
                    }
                } catch (e: Exception) {
                    errorMessage = "Ошибка: ${e.message}"
                } finally {
                    isStarting = false
                }
            }
        }
    }

    val qrBitmap = remember(url) {
        if (url == null) {
            null
        } else {
            val size = 400
            val matrix = QRCodeWriter().encode(
                url,
                BarcodeFormat.QR_CODE,
                size,
                size
            )
            Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888).also { bitmap ->
                for (x in 0 until size) {
                    for (y in 0 until size) {
                        bitmap.setPixel(
                            x,
                            y,
                            if (matrix[x, y]) android.graphics.Color.BLACK
                            else android.graphics.Color.WHITE
                        )
                    }
                }
            }
        }
    }

    Card(
        onClick = { toggleServer() },
        modifier = modifier
            .fillMaxWidth()
            .heightIn(min = if (isTV) 250.dp else 190.dp)
            .focusProperties {
                if (rightFocusRequester != null) right = rightFocusRequester
            }
            .focusRequester(focusRequester)
            .onFocusChanged { focused = it.isFocused }
            .then(
                if (focused) Modifier.border(
                    3.dp,
                    colors.primary,
                    RoundedCornerShape(22.dp)
                ) else Modifier
            ),
        shape = RoundedCornerShape(22.dp),
        colors = CardDefaults.cardColors(containerColor = colors.surface)
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(if (isTV) 6.dp else 16.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.spacedBy(if (isTV) 0.dp else 8.dp)
        ) {
            Image(
                painter = painterResource(
                    id = if (isRunning) R.drawable.power_on else R.drawable.power_off
                ),
                contentDescription = if (isRunning) "Выключить сервер" else "Включить сервер",
                modifier = Modifier.size(if (isTV) 80.dp else 96.dp)
            )

            Text(
                when {
                    isStarting -> "Подождите..."
                    isRunning -> "Сервер включён"
                    else -> "Нажмите OK, чтобы включить"
                },
                color = if (isRunning) colors.primary else colors.onSurface,
                fontSize = if (isTV) 22.sp else 14.sp,
                fontWeight = FontWeight.SemiBold,
                textAlign = TextAlign.Center
            )

            if (isRunning && url != null) {
                Text(
                    "Отсканируйте QR-код камерой телефона",
                    color = colors.onSurfaceVariant,
                    fontSize = if (isTV) 12.sp else 10.sp,
                    textAlign = TextAlign.Center
                )

                if (qrBitmap != null) {
                    Card(
                        colors = CardDefaults.cardColors(
                            containerColor = Color.White
                        ),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Image(
                            bitmap = qrBitmap.asImageBitmap(),
                            contentDescription = "QR-код для подключения",
                            modifier = Modifier
                                .size(if (isTV) 230.dp else 190.dp)
                                .padding(7.dp)
                        )
                    }
                }

                Text(
                    "Или введите этот адрес в браузере телефона",
                    color = colors.onSurfaceVariant,
                    fontSize = if (isTV) 12.sp else 10.sp,
                    textAlign = TextAlign.Center
                )

                Text(
                    url,
                    color = colors.primary,
                    fontSize = if (isTV) 22.sp else 14.sp,
                    fontWeight = FontWeight.Bold,
                    textAlign = TextAlign.Center
                )
            }

            errorMessage?.let {
                Text(
                    it,
                    color = colors.error,
                    fontSize = 12.sp,
                    textAlign = TextAlign.Center
                )
            }
        }
    }
}

@Composable
fun FilesCard(
    modifier: Modifier = Modifier,
    isTV: Boolean,
    onClick: () -> Unit,
    firstFileFocusRequester: FocusRequester? = null
) {
    val colors = MaterialTheme.colorScheme
    val context = androidx.compose.ui.platform.LocalContext.current

    var files by remember { mutableStateOf<List<StoredFile>>(emptyList()) }
    var focusedFile by remember { mutableStateOf<String?>(null) }
    var viewAllFocused by remember { mutableStateOf(false) }

    LaunchedEffect(Unit) {
        while (true) {
            files = withContext(Dispatchers.IO) {
                FileStorage.getFiles(context)
            }.sortedByDescending { it.lastModified }
            delay(1500)
        }
    }

    val recentFiles = files.take(5)

    fun formatSize(bytes: Long): String {
        return when {
            bytes < 1024 -> "$bytes Б"
            bytes < 1024 * 1024 -> String.format("%.1f КБ", bytes / 1024.0)
            bytes < 1024L * 1024L * 1024L ->
                String.format("%.1f МБ", bytes / (1024.0 * 1024.0))
            else -> String.format("%.2f ГБ", bytes / (1024.0 * 1024.0 * 1024.0))
        }
    }

    fun openFile(file: StoredFile) {
        try {
            val uri = FileProvider.getUriForFile(
                context,
                "${context.packageName}.fileprovider",
                java.io.File(FileStorage.getFolder(context), file.name)
            )

            val extension = file.name.substringAfterLast(".", "").lowercase()
            val mimeType = MimeTypeMap.getSingleton()
                .getMimeTypeFromExtension(extension) ?: "*/*"

            val intent = Intent(Intent.ACTION_VIEW).apply {
                setDataAndType(uri, mimeType)
                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            }

            context.startActivity(intent)
        } catch (_: android.content.ActivityNotFoundException) {
            Toast.makeText(
                context,
                "Нет приложения для открытия этого файла",
                Toast.LENGTH_LONG
            ).show()
        } catch (_: Exception) {
            Toast.makeText(
                context,
                "Не удалось открыть файл",
                Toast.LENGTH_LONG
            ).show()
        }
    }

    Card(
        modifier = modifier
            .fillMaxWidth()
            .then(if (isTV) Modifier.fillMaxHeight() else Modifier.heightIn(min = 190.dp)),
        shape = RoundedCornerShape(22.dp),
        colors = CardDefaults.cardColors(
            containerColor = colors.surface
        )
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(if (isTV) 26.dp else 14.dp),
            verticalArrangement = Arrangement.spacedBy(if (isTV) 8.dp else 6.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    "Последние файлы",
                    modifier = Modifier.weight(1f),
                    fontSize = if (isTV) 22.sp else 14.sp,
                    fontWeight = FontWeight.SemiBold,
                    color = colors.onSurface
                )
                Text(
                    "${files.size}",
                    fontSize = if (isTV) 15.sp else 13.sp,
                    color = colors.primary,
                    fontWeight = FontWeight.Bold
                )
            }

            if (recentFiles.isEmpty()) {
                Text(
                    "Файлов пока нет",
                    modifier = Modifier.padding(vertical = 14.dp),
                    fontSize = if (isTV) 18.sp else 12.sp,
                    color = colors.onSurfaceVariant
                )
            } else {
                recentFiles.forEachIndexed { index, file ->
                    var rowFocused by remember(file.name) {
                        mutableStateOf(false)
                    }

                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .then(
                                if (index == 0 && firstFileFocusRequester != null)
                                    Modifier.focusRequester(firstFileFocusRequester)
                                else Modifier
                            )
                            .onFocusChanged { rowFocused = it.isFocused }
                            .background(
                                if (rowFocused) colors.primary.copy(alpha = 0.14f)
                                else Color.Transparent,
                                RoundedCornerShape(10.dp)
                            )
                            .border(
                                width = if (rowFocused) 2.dp else 0.dp,
                                color = if (rowFocused) colors.primary
                                else Color.Transparent,
                                shape = RoundedCornerShape(10.dp)
                            )
                            .clickable { openFile(file) }
                            .padding(
                                horizontal = if (isTV) 10.dp else 7.dp,
                                vertical = if (isTV) 13.dp else 5.dp
                            ),
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.spacedBy(9.dp)
                    ) {
                        Text(
                            "▤",
                            color = colors.primary,
                            fontSize = if (isTV) 27.sp else 18.sp
                        )

                        Column(modifier = Modifier.weight(1f)) {
                            Text(
                                file.name,
                                fontSize = if (isTV) 18.sp else 12.sp,
                                color = colors.onSurface,
                                maxLines = 1,
                                overflow = androidx.compose.ui.text.style.TextOverflow.Ellipsis
                            )

                            Text(
                                "${formatSize(file.size)}  •  ${
                                    android.text.format.DateFormat.format(
                                        "dd.MM HH:mm",
                                        file.lastModified
                                    )
                                }",
                                fontSize = if (isTV) 14.sp else 10.sp,
                                color = colors.onSurfaceVariant,
                                maxLines = 1
                            )
                        }
                    }
                }
            }

            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .onFocusChanged { viewAllFocused = it.isFocused }
                    .background(
                        if (viewAllFocused) colors.primary.copy(alpha = 0.14f)
                        else colors.surfaceVariant,
                        RoundedCornerShape(10.dp)
                    )
                    .border(
                        width = if (viewAllFocused) 2.dp else 0.dp,
                        color = if (viewAllFocused) colors.primary
                        else Color.Transparent,
                        shape = RoundedCornerShape(10.dp)
                    )
                    .clickable(onClick = onClick)
                    .padding(horizontal = 12.dp, vertical = if (isTV) 9.dp else 7.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    "Просмотреть все",
                    modifier = Modifier.weight(1f),
                    color = colors.onSurface,
                    fontWeight = FontWeight.Medium,
                    fontSize = if (isTV) 13.sp else 11.sp
                )
                Text(
                    "→",
                    color = colors.primary,
                    fontSize = 18.sp
                )
            }
        }
    }
}

@OptIn(ExperimentalFoundationApi::class)
@Composable
fun FilesScreen(onBack: () -> Unit) {
    val colors = MaterialTheme.colorScheme
    val context = androidx.compose.ui.platform.LocalContext.current
    val scope = rememberCoroutineScope()

    var files by remember { mutableStateOf<List<StoredFile>>(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }
    var refreshKey by remember { mutableStateOf(0) }
    var selectedFile by remember { mutableStateOf<StoredFile?>(null) }
    var fileToDelete by remember { mutableStateOf<StoredFile?>(null) }
    var suppressFileClickUntil by remember { mutableStateOf(0L) }

    LaunchedEffect(refreshKey) {
        isLoading = true
        files = withContext(Dispatchers.IO) {
            FileStorage.getFiles(context)
        }
        isLoading = false
    }

    fun openFile(file: StoredFile) {
        try {
            val uri = FileProvider.getUriForFile(
                context,
                "${context.packageName}.fileprovider",
                java.io.File(
                    FileStorage.getFolder(context),
                    file.name
                )
            )

            val extension = file.name.substringAfterLast(
                ".",
                ""
            ).lowercase()

            val mimeType = MimeTypeMap.getSingleton()
                .getMimeTypeFromExtension(extension)
                ?: "*/*"

            val intent = Intent(Intent.ACTION_VIEW).apply {
                setDataAndType(uri, mimeType)
                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            }

            context.startActivity(intent)
        } catch (_: android.content.ActivityNotFoundException) {
            Toast.makeText(
                context,
                "Нет приложения для открытия этого файла",
                Toast.LENGTH_LONG
            ).show()
        } catch (_: Exception) {
            Toast.makeText(
                context,
                "Не удалось открыть файл",
                Toast.LENGTH_LONG
            ).show()
        }
    }

    BoxWithConstraints(
        modifier = Modifier
            .fillMaxSize()
            .background(colors.background)
    ) {
        val isTV = maxWidth >= 700.dp

        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(
                    horizontal = if (isTV) 48.dp else 20.dp,
                    vertical = if (isTV) 32.dp else 24.dp
                )
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Button(
                    onClick = onBack,
                    shape = RoundedCornerShape(12.dp)
                ) {
                    Text("←  Назад")
                }

                Spacer(Modifier.width(20.dp))

                Text(
                    "Мои файлы",
                    modifier = Modifier.weight(1f),
                    fontSize = if (isTV) 29.sp else 22.sp,
                    fontWeight = FontWeight.Bold,
                    color = colors.onBackground
                )

                TextButton(onClick = { refreshKey++ }) {
                    Text("Обновить")
                }
            }

            Spacer(Modifier.height(20.dp))

            Text(
                "Хранилище приложения / PhoneTransfer",
                fontSize = if (isTV) 16.sp else 13.sp,
                color = colors.onSurfaceVariant
            )

            Spacer(Modifier.height(12.dp))

            Text(
                "Файлов: ${files.size}",
                fontSize = 13.sp,
                color = colors.onSurfaceVariant
            )

            Spacer(Modifier.height(16.dp))

            if (isLoading) {
                Box(
                    modifier = Modifier
                        .fillMaxWidth()
                        .weight(1f),
                    contentAlignment = Alignment.Center
                ) {
                    CircularProgressIndicator()
                }
            } else if (files.isEmpty()) {
                Card(
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(22.dp),
                    colors = CardDefaults.cardColors(
                        containerColor = colors.surface
                    )
                ) {
                    Column(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(32.dp),
                        horizontalAlignment = Alignment.CenterHorizontally,
                        verticalArrangement = Arrangement.spacedBy(12.dp)
                    ) {
                        Text(
                            "Пока нет файлов",
                            fontSize = if (isTV) 22.sp else 18.sp,
                            fontWeight = FontWeight.SemiBold,
                            color = colors.onSurface
                        )

                        Text(
                            "Переданные файлы будут отображаться здесь.\n" +
                                "Сервер запускать для просмотра не требуется.",
                            fontSize = if (isTV) 15.sp else 13.sp,
                            color = colors.onSurfaceVariant,
                            textAlign = TextAlign.Center,
                            lineHeight = 22.sp
                        )
                    }
                }
            } else {
                Column(
                    modifier = Modifier
                        .weight(1f)
                        .fillMaxWidth()
                        .then(if (isTV) Modifier else Modifier.verticalScroll(rememberScrollState())),
                    verticalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    files.forEach { file ->
                        var focused by remember(file.name) {
                            mutableStateOf(false)
                        }

                        Box {
                            Card(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .onFocusChanged {
                                        focused = it.isFocused
                                    }
                                    .onPreviewKeyEvent { event ->
                                        val keyCode = event.nativeKeyEvent.keyCode
                                        val isOkKey =
                                            keyCode == android.view.KeyEvent.KEYCODE_DPAD_CENTER ||
                                            keyCode == android.view.KeyEvent.KEYCODE_ENTER

                                        when {
                                            !isOkKey -> false

                                            event.type == KeyEventType.KeyDown &&
                                                (event.nativeKeyEvent.repeatCount > 0 ||
                                                 event.nativeKeyEvent.isLongPress) -> {
                                                selectedFile = file
                                                true
                                            }

                                            event.type == KeyEventType.KeyUp &&
                                                selectedFile?.name == file.name -> true

                                            else -> false
                                        }
                                    }
                                    .combinedClickable(
                                        onClick = {
                                            if (android.os.SystemClock.uptimeMillis() >= suppressFileClickUntil) {
                                                openFile(file)
                                            }
                                        },
                                        onLongClick = {
                                            suppressFileClickUntil =
                                                android.os.SystemClock.uptimeMillis() + 800L
                                            selectedFile = file
                                        }
                                    )
                                    .then(
                                        if (focused) {
                                            Modifier.border(
                                                3.dp,
                                                colors.primary,
                                                RoundedCornerShape(16.dp)
                                            )
                                        } else {
                                            Modifier
                                        }
                                    ),
                                shape = RoundedCornerShape(16.dp),
                                colors = CardDefaults.cardColors(
                                    containerColor = if (focused) {
                                        colors.surfaceVariant
                                    } else {
                                        colors.surface
                                    }
                                )
                            ) {
                                Row(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .padding(
                                            horizontal = 22.dp,
                                            vertical = if (isTV) 22.dp else 16.dp
                                        ),
                                    verticalAlignment = Alignment.CenterVertically
                                ) {
                                    Column(
                                        modifier = Modifier.weight(1f),
                                        verticalArrangement = Arrangement.spacedBy(7.dp)
                                    ) {
                                        Text(
                                            file.name,
                                            fontSize = if (isTV) 19.sp else 15.sp,
                                            fontWeight = FontWeight.SemiBold,
                                            color = colors.onSurface
                                        )

                                        Text(
                                            "Размер: ${formatFileSize(file.size)}",
                                            fontSize = 13.sp,
                                            color = colors.onSurfaceVariant
                                        )

                                        Text(
                                            "Изменён: ${formatFileDate(file.lastModified)}",
                                            fontSize = 12.sp,
                                            color = colors.onSurfaceVariant
                                        )
                                    }

                                    Text(
                                        "›",
                                        fontSize = 30.sp,
                                        color = colors.primary
                                    )
                                }
                            }

                            DropdownMenu(
                                expanded = selectedFile?.name == file.name,
                                onDismissRequest = {
                                    selectedFile = null
                                }
                            ) {
                                DropdownMenuItem(
                                    text = { Text("Открыть") },
                                    onClick = {
                                        selectedFile = null
                                        openFile(file)
                                    }
                                )

                                DropdownMenuItem(
                                    text = {
                                        Text(
                                            "Удалить",
                                            color = colors.error
                                        )
                                    },
                                    onClick = {
                                        selectedFile = null
                                        fileToDelete = file
                                    }
                                )
                            }
                        }
                    }
                }
            }
        }
    }

    fileToDelete?.let { file ->
        AlertDialog(
            onDismissRequest = {
                fileToDelete = null
            },
            title = {
                Text("Удалить файл?")
            },
            text = {
                Text(
                    "Файл «${file.name}» будет удалён без возможности восстановления."
                )
            },
            confirmButton = {
                Button(
                    onClick = {
                        fileToDelete = null

                        scope.launch {
                            val deleted = withContext(Dispatchers.IO) {
                                FileStorage.deleteFile(context, file.name)
                            }

                            if (deleted) {
                                Toast.makeText(
                                    context,
                                    "Файл удалён",
                                    Toast.LENGTH_SHORT
                                ).show()
                                refreshKey++
                            } else {
                                Toast.makeText(
                                    context,
                                    "Не удалось удалить файл",
                                    Toast.LENGTH_LONG
                                ).show()
                            }
                        }
                    },
                    colors = ButtonDefaults.buttonColors(
                        containerColor = colors.error
                    )
                ) {
                    Text("Удалить")
                }
            },
            dismissButton = {
                TextButton(
                    onClick = { fileToDelete = null }
                ) {
                    Text("Отмена")
                }
            }
        )
    }
}

private fun formatFileSize(size: Long): String {
    return when {
        size < 1024 -> "$size Б"
        size < 1024 * 1024 ->
            String.format("%.1f КБ", size / 1024.0)
        size < 1024L * 1024 * 1024 ->
            String.format("%.1f МБ", size / (1024.0 * 1024))
        else ->
            String.format("%.2f ГБ", size / (1024.0 * 1024 * 1024))
    }
}

private fun formatFileDate(timestamp: Long): String {
    if (timestamp <= 0L) return "неизвестно"

    return java.text.SimpleDateFormat(
        "dd.MM.yyyy HH:mm",
        java.util.Locale.getDefault()
    ).format(java.util.Date(timestamp))
}

